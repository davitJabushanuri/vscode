{
  "name": "chat",
  "displayName": "Chat",
  "description": "Autonomous coding agent right in your IDE, capable of creating/editing files, running commands, using the browser, and more with your permission every step of the way.",
  "version": "3.27.0",
  "icon": "assets/icons/icon.png",
  "engines": {
    "vscode": "^1.84.0"
  },
  "author": {
    "name": "Kodik"
  },
  "license": "Apache-2.0",
  "publisher": "kodik",
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Education",
    "Snippets",
    "Testing"
  ],
  "keywords": [
    "dev",
    "mcp",
    "openrouter",
    "coding",
    "agent",
    "autonomous",
    "chatgpt",
    "sonnet",
    "ai",
    "llama"
  ],
  "activationEvents": [
    "onLanguage",
    "onStartupFinished",
    "workspaceContains:evals.env"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "walkthroughs": [
      {
        "id": "KodikWalkthrough",
        "title": "%walkthrough.title%",
        "description": "%walkthrough.description%",
        "steps": [
          {
            "id": "welcome",
            "title": "%walkthrough.step1.title%",
            "description": "%walkthrough.step1.description%",
            "media": {
              "markdown": "walkthrough/step1.md"
            }
          },
          {
            "id": "learn",
            "title": "%walkthrough.step2.title%",
            "description": "%walkthrough.step2.description%",
            "media": {
              "markdown": "walkthrough/step2.md"
            }
          },
          {
            "id": "advanced-features",
            "title": "%walkthrough.step3.title%",
            "description": "%walkthrough.step3.description%",
            "media": {
              "markdown": "walkthrough/step3.md"
            }
          },
          {
            "id": "mcp",
            "title": "%walkthrough.step4.title%",
            "description": "%walkthrough.step4.description%",
            "media": {
              "markdown": "walkthrough/step4.md"
            }
          },
          {
            "id": "getting-started",
            "title": "%walkthrough.step5.title%",
            "description": "%walkthrough.step5.description%",
            "media": {
              "markdown": "walkthrough/step5.md"
            },
            "content": {
              "path": "walkthrough/step5.md"
            }
          }
        ]
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "claude-dev-ActivityBar",
          "title": "Kodik",
          "icon": "assets/icons/icon.svg"
        }
      ]
    },
    "views": {
      "claude-dev-ActivityBar": [
        {
          "type": "webview",
          "id": "claude-dev.SidebarProvider",
          "name": "",
          "icon": "assets/icons/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "kodik.plusButtonClicked",
        "title": "%command.newTask.title%",
        "icon": "$(add)"
      },
      {
        "command": "kodik.mcpButtonClicked",
        "title": "%command.mcpServers.title%",
        "icon": "$(server)"
      },
      {
        "command": "kodik.historyButtonClicked",
        "title": "%command.history.title%",
        "icon": "$(history)"
      },
      {
        "command": "kodik.popoutButtonClicked",
        "title": "%command.openInEditor.title%",
        "icon": "$(link-external)"
      },
      {
        "command": "kodik.accountButtonClicked",
        "title": "%command.account.title%",
        "icon": "$(account)"
      },
      {
        "command": "kodik.settingsButtonClicked",
        "title": "%command.settings.title%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "kodik.openInNewTab",
        "title": "%command.openInNewTab.title%",
        "category": "%category.kodik%"
      },
      {
        "command": "kodik.dev.createTestTasks",
        "title": "%command.createTestTasks.title%",
        "category": "%category.kodik%",
        "when": "kodik.isDevMode"
      },
      {
        "command": "kodik.addToChat",
        "title": "%command.addToChat.title%",
        "category": "%category.kodik%"
      },
      {
        "command": "kodik.addTerminalOutputToChat",
        "title": "%command.addTerminalOutput.title%",
        "category": "%category.kodik%"
      },
      {
        "command": "kodik.focusChatInput",
        "title": "%command.focusChatInput.title%",
        "category": "%category.kodik%"
      },
      {
        "command": "kodik.generateGitCommitMessage",
        "title": "%command.generateCommitMessage.title%",
        "category": "%category.kodik%",
        "icon": "$(robot)"
      },
      {
        "command": "kodik.abortGitCommitMessage",
        "title": "%command.generateCommitMessageStop.title%",
        "category": "%category.kodik%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "kodik.explainCode",
        "title": "%command.explainCode.title%",
        "category": "%category.kodik%"
      },
      {
        "command": "kodik.improveCode",
        "title": "%command.improveCode.title%",
        "category": "%category.kodik%"
      },
      {
        "command": "kodik.openWalkthrough",
        "title": "%command.openWalkthrough.title%",
        "category": "%category.kodik%"
      }
    ],
    "keybindings": [
      {
        "command": "kodik.addToChat",
        "key": "cmd+'",
        "mac": "cmd+'",
        "win": "ctrl+'",
        "linux": "ctrl+'",
        "when": "editorHasSelection"
      },
      {
        "command": "kodik.generateGitCommitMessage",
        "when": "config.git.enabled && scmProvider == git"
      },
      {
        "command": "kodik.focusChatInput",
        "key": "cmd+'",
        "mac": "cmd+'",
        "win": "ctrl+'",
        "linux": "ctrl+'",
        "when": "!editorHasSelection"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kodik.plusButtonClicked",
          "group": "navigation@1",
          "when": "view == claude-dev.SidebarProvider"
        },
        {
          "command": "kodik.mcpButtonClicked",
          "group": "navigation@2",
          "when": "view == claude-dev.SidebarProvider"
        },
        {
          "command": "kodik.historyButtonClicked",
          "group": "navigation@3",
          "when": "view == claude-dev.SidebarProvider"
        },
        {
          "command": "kodik.popoutButtonClicked",
          "group": "navigation@4",
          "when": "view == claude-dev.SidebarProvider"
        },
        {
          "command": "kodik.accountButtonClicked",
          "group": "navigation@5",
          "when": "view == claude-dev.SidebarProvider"
        },
        {
          "command": "kodik.settingsButtonClicked",
          "group": "navigation@6",
          "when": "view == claude-dev.SidebarProvider"
        }
      ],
      "editor/title": [
        {
          "command": "kodik.plusButtonClicked",
          "group": "navigation@1",
          "when": "activeWebviewPanelId == claude-dev.TabPanelProvider"
        },
        {
          "command": "kodik.mcpButtonClicked",
          "group": "navigation@2",
          "when": "activeWebviewPanelId == claude-dev.TabPanelProvider"
        },
        {
          "command": "kodik.historyButtonClicked",
          "group": "navigation@3",
          "when": "activeWebviewPanelId == claude-dev.TabPanelProvider"
        },
        {
          "command": "kodik.popoutButtonClicked",
          "group": "navigation@4",
          "when": "activeWebviewPanelId == claude-dev.TabPanelProvider"
        },
        {
          "command": "kodik.accountButtonClicked",
          "group": "navigation@5",
          "when": "activeWebviewPanelId == claude-dev.TabPanelProvider"
        },
        {
          "command": "kodik.settingsButtonClicked",
          "group": "navigation@6",
          "when": "activeWebviewPanelId == claude-dev.TabPanelProvider"
        }
      ],
      "editor/context": [
        {
          "command": "kodik.addToChat",
          "group": "navigation",
          "when": "editorHasSelection"
        }
      ],
      "terminal/context": [
        {
          "command": "kodik.addTerminalOutputToChat",
          "group": "navigation"
        }
      ],
      "scm/title": [
        {
          "command": "kodik.generateGitCommitMessage",
          "group": "navigation",
          "when": "config.git.enabled && scmProvider == git && !kodik.isGeneratingCommit"
        },
        {
          "command": "kodik.abortGitCommitMessage",
          "group": "navigation",
          "when": "config.git.enabled && scmProvider == git && kodik.isGeneratingCommit"
        }
      ],
      "commandPalette": [
        {
          "command": "kodik.generateGitCommitMessage",
          "when": "config.git.enabled && scmProvider == git && !kodik.isGeneratingCommit"
        },
        {
          "command": "kodik.abortGitCommitMessage",
          "when": "config.git.enabled && scmProvider == git && kodik.isGeneratingCommit"
        }
      ]
    },
    "configuration": {
      "title": "Kodik",
      "properties": {}
    }
  },
  "scripts": {},
  "lint-staged": {
    "*": [
      "biome check --write --staged --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  }
}