{
  "name": "chat",
  "displayName": "Chat",
  "description": "Autonomous coding agent right in your IDE, capable of creating/editing files, running commands, using the browser, and more with your permission every step of the way.",
  "version": "3.27.0",
  "icon": "assets/icons/icon.png",
  "engines": {
    "vscode": "^1.84.0"
  },
  "author": {
    "name": "Kodik"
  },
  "license": "MIT",
  "publisher": "kodik",
  "repository": {
    "type": "git",
    "url": "https://github.com/davitJabushanuri/kodik"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Education",
    "Snippets",
    "Testing"
  ],
  "keywords": [
    "dev",
    "mcp",
    "openrouter",
    "coding",
    "agent",
    "autonomous",
    "chatgpt",
    "sonnet",
    "ai",
    "llama"
  ],
  "activationEvents": [
    "onLanguage",
    "onStartupFinished",
    "workspaceContains:evals.env"
  ],
  "enabledApiProposals": [
    "inlineCompletionsAdditions",
    "languageModelSystem",
    "chatParticipantAdditions",
    "defaultChatParticipant"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "kodik-ActivityBar",
          "title": "Kodik",
          "icon": "assets/icons/icon.svg"
        }
      ],
      "panel": [
        {
          "id": "kodik-Panel",
          "title": "Kodik",
          "icon": "assets/icons/icon.svg"
        }
      ]
    },
    "views": {
      "kodik-ActivityBar": [
        {
          "type": "webview",
          "id": "kodik.SidebarProvider",
          "name": "",
          "icon": "assets/icons/icon.svg"
        }
      ],
      "kodik-Panel": [
        {
          "type": "webview",
          "id": "kodik.PanelProvider",
          "name": "Kodik",
          "icon": "assets/icons/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "kodik.plusButtonClicked",
        "title": "%command.newTask.title%",
        "icon": "$(add)"
      },
      {
        "command": "kodik.mcpButtonClicked",
        "title": "%command.mcpServers.title%",
        "icon": "$(server)"
      },
      {
        "command": "kodik.historyButtonClicked",
        "title": "%command.history.title%",
        "icon": "$(history)"
      },
      {
        "command": "kodik.popoutButtonClicked",
        "title": "%command.openInEditor.title%",
        "icon": "$(link-external)"
      },
      {
        "command": "kodik.accountButtonClicked",
        "title": "%command.account.title%",
        "icon": "$(account)"
      },
      {
        "command": "kodik.settingsButtonClicked",
        "title": "%command.settings.title%",
        "icon": "$(settings-gear)"
      },
      {
        "command": "kodik.openInNewTab",
        "title": "%command.openInNewTab.title%",
        "category": "%category.kodik%"
      },
      {
        "command": "kodik.openChatFromEditor",
        "title": "Kodik: Open Chat",
        "category": "%category.kodik%",
        "icon": {
          "light": "assets/icons/icon.svg",
          "dark": "assets/icons/icon.svg"
        }
      },
      {
        "command": "kodik.dev.createTestTasks",
        "title": "%command.createTestTasks.title%",
        "category": "%category.kodik%",
        "when": "kodik.isDevMode"
      },
      {
        "command": "kodik.addToChat",
        "title": "%command.addToChat.title%",
        "category": "%category.kodik%"
      },
      {
        "command": "kodik.addTerminalOutputToChat",
        "title": "%command.addTerminalOutput.title%",
        "category": "%category.kodik%"
      },
      {
        "command": "kodik.focusChatInput",
        "title": "%command.focusChatInput.title%",
        "category": "%category.kodik%"
      },
      {
        "command": "kodik.generateGitCommitMessage",
        "title": "%command.generateCommitMessage.title%",
        "category": "%category.kodik%",
        "icon": "$(robot)"
      },
      {
        "command": "kodik.abortGitCommitMessage",
        "title": "%command.generateCommitMessageStop.title%",
        "category": "%category.kodik%",
        "icon": "$(debug-stop)"
      },
      {
        "command": "kodik.explainCode",
        "title": "%command.explainCode.title%",
        "category": "%category.kodik%"
      },
      {
        "command": "kodik.improveCode",
        "title": "%command.improveCode.title%",
        "category": "%category.kodik%"
      },
      {
        "command": "kodik.autocomplete.toggle",
        "title": "Toggle Autocomplete",
        "category": "%category.kodik%"
      },
      {
        "command": "kodik.autocomplete.manualTrigger",
        "title": "Manual Autocomplete Trigger (Debug)",
        "category": "%category.kodik%"
      },
      {
        "command": "kodik.autocomplete.debugStatus",
        "title": "Autocomplete Debug Status",
        "category": "%category.kodik%"
      },
      {
        "command": "kodik.autocomplete.testCompletion",
        "title": "Test Autocomplete Insertion",
        "category": "%category.kodik%"
      },
      {
        "command": "kodik.autocomplete.forceShow",
        "title": "Force Show Autocomplete",
        "category": "%category.kodik%"
      },
      {
        "command": "kodik.autocomplete.insertCompletion",
        "title": "Insert Autocomplete (Direct)",
        "category": "%category.kodik%"
      },
      {
        "command": "kodik.autocomplete.fixSettings",
        "title": "Fix VS Code Inline Completion Settings",
        "category": "%category.kodik%"
      }
    ],
    "keybindings": [
      {
        "command": "kodik.addToChat",
        "key": "cmd+'",
        "mac": "cmd+'",
        "win": "ctrl+'",
        "linux": "ctrl+'",
        "when": "editorHasSelection"
      },
      {
        "command": "kodik.generateGitCommitMessage",
        "when": "config.git.enabled && scmProvider == git"
      },
      {
        "command": "kodik.focusChatInput",
        "key": "cmd+'",
        "mac": "cmd+'",
        "win": "ctrl+'",
        "linux": "ctrl+'",
        "when": "!editorHasSelection"
      },
      {
        "command": "kodik.autocomplete.toggle",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a",
        "win": "ctrl+shift+a",
        "linux": "ctrl+shift+a"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "kodik.plusButtonClicked",
          "group": "navigation@1",
          "when": "view == kodik.SidebarProvider"
        },
        {
          "command": "kodik.mcpButtonClicked",
          "group": "navigation@2",
          "when": "view == kodik.SidebarProvider"
        },
        {
          "command": "kodik.historyButtonClicked",
          "group": "navigation@3",
          "when": "view == kodik.SidebarProvider"
        },
        {
          "command": "kodik.popoutButtonClicked",
          "group": "navigation@4",
          "when": "view == kodik.SidebarProvider"
        },
        {
          "command": "kodik.accountButtonClicked",
          "group": "navigation@5",
          "when": "view == kodik.SidebarProvider"
        },
        {
          "command": "kodik.settingsButtonClicked",
          "group": "navigation@6",
          "when": "view == kodik.SidebarProvider"
        }
      ],
      "editor/title": [
        {
          "command": "kodik.plusButtonClicked",
          "group": "navigation@1",
          "when": "activeWebviewPanelId == kodik.TabPanelProvider"
        },
        {
          "command": "kodik.mcpButtonClicked",
          "group": "navigation@2",
          "when": "activeWebviewPanelId == kodik.TabPanelProvider"
        },
        {
          "command": "kodik.historyButtonClicked",
          "group": "navigation@3",
          "when": "activeWebviewPanelId == kodik.TabPanelProvider"
        },
        {
          "command": "kodik.popoutButtonClicked",
          "group": "navigation@4",
          "when": "activeWebviewPanelId == kodik.TabPanelProvider"
        },
        {
          "command": "kodik.accountButtonClicked",
          "group": "navigation@5",
          "when": "activeWebviewPanelId == kodik.TabPanelProvider"
        },
        {
          "command": "kodik.settingsButtonClicked",
          "group": "navigation@6",
          "when": "activeWebviewPanelId == kodik.TabPanelProvider"
        }
      ],
      "editor/context": [
        {
          "command": "kodik.addToChat",
          "group": "navigation",
          "when": "editorHasSelection"
        }
      ],
      "terminal/context": [
        {
          "command": "kodik.addTerminalOutputToChat",
          "group": "navigation"
        }
      ],
      "scm/title": [
        {
          "command": "kodik.generateGitCommitMessage",
          "group": "navigation",
          "when": "config.git.enabled && scmProvider == git && !kodik.isGeneratingCommit"
        },
        {
          "command": "kodik.abortGitCommitMessage",
          "group": "navigation",
          "when": "config.git.enabled && scmProvider == git && kodik.isGeneratingCommit"
        }
      ],
      "commandPalette": [
        {
          "command": "kodik.generateGitCommitMessage",
          "when": "config.git.enabled && scmProvider == git && !kodik.isGeneratingCommit"
        },
        {
          "command": "kodik.abortGitCommitMessage",
          "when": "config.git.enabled && scmProvider == git && kodik.isGeneratingCommit"
        }
      ]
    },
    "configuration": {
      "title": "Kodik",
      "properties": {
        "kodik.autocompletion.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable AI-powered autocompletion",
          "order": 1
        },
        "kodik.autocompletion.debounceDelay": {
          "type": "number",
          "default": 300,
          "minimum": 50,
          "maximum": 2000,
          "description": "Delay in milliseconds before triggering autocompletion",
          "order": 2
        },
        "kodik.autocompletion.maxCompletionLength": {
          "type": "number",
          "default": 500,
          "minimum": 100,
          "maximum": 2000,
          "description": "Maximum length of completion suggestions",
          "order": 3
        },
        "kodik.autocompletion.contextLines": {
          "type": "number",
          "default": 20,
          "minimum": 5,
          "maximum": 100,
          "description": "Number of context lines to include before and after cursor",
          "order": 4
        },
        "kodik.autocompletion.excludePatterns": {
          "type": "array",
          "default": [
            "*.log",
            "*.tmp",
            "node_modules/**",
            ".git/**"
          ],
          "items": {
            "type": "string"
          },
          "description": "File patterns to exclude from autocompletion",
          "order": 5
        }
      }
    }
  },
  "scripts": {},
  "lint-staged": {
    "*": [
      "biome check --write --staged --no-errors-on-unmatched --files-ignore-unknown=true"
    ]
  }
}